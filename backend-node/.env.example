# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=newdatainsights
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=super_secure_jwt_secret_for_production

# Redis (optional)
REDIS_URI=redis://localhost:6379

# MongoDB (optional - used in docker-compose)
MONGO_URI=mongodb://localhost:27017/datainsights
